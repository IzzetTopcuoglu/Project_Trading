# Binance API anahtarların (public OHLCV verisi icin ZORUNLU degil,
# ileride emir gonderme/hesap bilgisi icin gerekecek). Bos birakabilirsin.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Islem yapilacak sembol ve mum araligi
SYMBOL=BTC/USDT
TIMEFRAME=5m

# Ne kadar geriye gidip veri cekelim (gun)
LOOKBACK_DAYS=180

# LSTM kac mumluk pencereye baksin (60 * 5dk = 5 saat gerive bakis)
WINDOW=60

# Veri ve model dosyalarinin tutulacagi klasorler
DATA_DIR=data
MODEL_DIR=artifacts

# CoinGecko ucretsiz Demo API key'i (coingecko.com/en/api/pricing uzerinden
# ucretsiz kayit olup alinir). Sadece makro/cross-asset veri (yaklasik toplam
# kripto piyasa degeri, USDT hacmi) cekmek icin lazim, BTC verisi icin gerekmiyor.
COINGECKO_API_KEY=

# True yaparsan train.py/predict.py makro_daily verisini de (1 gun
# gecikmeli, bkz. dataset.py) LSTM'in feature setine ekler. Once
# python -m src.data.fetch_macro_data calistirilmis olmali.
INCLUDE_MACRO=false

# XAUT (Tether Gold - Binance'de 7/24 islem goren altina bagli kripto
# token) sembolu. Degistirmene gerek yok, oldugu gibi birakabilirsin.
XAUT_SYMBOL=XAUT/USDT

# True yaparsan train.py/predict.py XAUT'un (altin) ayni anki (leakage
# riski olmadan, BTC ile ayni mum araliginda) getirisini de LSTM'in
# feature setine ekler. Once python -m src.data.fetch_xaut_data
# calistirilmis olmali.
INCLUDE_XAUT=false

# Orderbook (emir defteri) analizinde en iyi kac fiyat seviyesine
# bakilsin (alis/satis hacmi bu kadar seviyeden toplanir). Bu, LSTM
# egitim verisine degil, LLM Agent'in canli kararina giren bir sinyaldir
# (bkz. src/data/orderbook.py - Binance gecmise donuk orderbook vermiyor).
ORDERBOOK_DEPTH=20

# True yaparsan LSTM, ekonomik takvim ozelliklerini de (bir sonraki
# yuksek etkili FOMC/CPI/NFP olayina kac gun kaldigi) kullanir - bu,
# orderbook'un aksine gecmise de uygulanabilir (bkz.
# src/data/economic_calendar.py), o yuzden onceden ayri bir fetch
# scripti calistirmana gerek yok, statik/elle girilmis bir liste.
INCLUDE_CALENDAR=false

# --- LLM Agent (Katman 2) ---
# console.anthropic.com uzerinden alinan API anahtarin. Bos birakirsan
# agent otomatik olarak guvenli varsayilana (islem acma) duser.
ANTHROPIC_API_KEY=
# Guncel model id'lerini https://docs.claude.com/en/docs/about-claude/models
# adresinden kontrol et.
LLM_MODEL=claude-sonnet-4-5

# --- Otomasyon (Katman 3: emir gonderme + Telegram) ---
# GUVENLIK: true iken gercek emir GONDERILMEZ, sadece plan loglanir.
# Once true ile birkac tur dene, sonuclari incele, sonra bilerek
# false yap. Gercek parayla test etmeden false'a gecme!
DRY_RUN=true

# True yaparsan (VE DRY_RUN=false iken) emirler GERCEK hesabina degil
# Binance Futures TESTNET'ine (sahte parayla) gider - uctan uca akisi
# risksiz denemek icin. testnet.binancefuture.com'dan AYRI bir hesap/
# API anahtari almalisin (mainnet anahtarin burada calismaz).
BINANCE_TESTNET=false
TESTNET_API_KEY=
TESTNET_API_SECRET=

# Her islemde toplam sermayenin ne kadari (kaldiractan ONCE) marjin
# olarak kullanilsin - ör. 0.1 = sermayenin %10'u
POSITION_SIZE_FRACTION=0.1

# Gunluk oturum basi sermayeye gore bu yuzdeyi asan bir kayipta sistem
# otomatik olarak durur (global zarar kurali / circuit breaker)
GLOBAL_LOSS_LIMIT_PCT=5

# @BotFather'dan aldigin bot token'i ve kendi Telegram chat_id'n
# (bkz. src/automation/telegram_bot.py ustundeki kurulum notu)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
